[Unit]
Description=moayeyak web (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/app
EnvironmentFile=/srv/app/.env
ExecStart=/srv/app/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
